mode org-mode
face bold :weight bold
face font-lock-comment-face :weight light :slant italic
face font-lock-doc-face
face font-lock-function-name-face
face font-lock-keyword-face
face italic :slant italic
face org-block
face org-block-begin-line :slant italic
face org-block-end-line :slant italic
face org-checkbox :inherit bold
face org-code
face org-document-info-keyword
face org-document-title :height 1.4 :weight bold
face org-drawer
face org-headline-done
face org-level-1 :inherit rainbow-delimiters-depth-1-face :height 1.35 :weight bold
face org-level-2 :inherit rainbow-delimiters-depth-2-face :height 1.2 :weight bold
face org-link
face org-meta-line :inherit font-lock-comment-face
face org-modern-block-name :height 0.8 :weight light
face org-modern-date-active :inherit org-modern-label
face org-modern-date-inactive :inherit org-modern-label
face org-modern-done :inherit org-modern-label
face org-modern-tag :inherit (secondary-selection org-modern-label)
face org-modern-time-inactive :inherit org-modern-label
face org-modern-todo :inherit (org-todo org-modern-label) :weight semibold
face org-property-value :inherit default
face org-special-keyword
face org-table
face org-table-row :inherit org-table
face org-verbatim :inherit shadow
face rainbow-delimiters-depth-1-face
face rainbow-delimiters-depth-2-face
