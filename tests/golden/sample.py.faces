mode python-ts-mode
face font-lock-builtin-face
face font-lock-comment-face :weight light :slant italic
face font-lock-constant-face
face font-lock-doc-face
face font-lock-escape-face
face font-lock-function-name-face
face font-lock-keyword-face
face font-lock-misc-punctuation-face :inherit font-lock-punctuation-face
face font-lock-number-face
face font-lock-string-face
face font-lock-type-face
face font-lock-variable-name-face
face indent-bars-1 :inherit indent-bars-face
face indent-bars-2 :inherit indent-bars-face
face rainbow-delimiters-depth-1-face
face rainbow-delimiters-depth-2-face
face rainbow-delimiters-depth-3-face
