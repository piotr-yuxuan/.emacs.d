mode sh-mode
face font-lock-builtin-face
face font-lock-comment-delimiter-face
face font-lock-comment-face :weight light :slant italic
face font-lock-function-name-face
face font-lock-keyword-face
face font-lock-negation-char-face
face font-lock-string-face
face font-lock-variable-name-face
face rainbow-delimiters-depth-1-face
face rainbow-delimiters-depth-2-face
face sh-heredoc :inherit font-lock-string-face :weight normal
face sh-quoted-exec :inherit font-lock-preprocessor-face
1:0 font-lock-comment-delimiter-face "#"
1:1 font-lock-comment-face "!/usr/bin/"
1:11 font-lock-keyword-face "env"
1:14 font-lock-comment-face " bash\n"
2:0 font-lock-comment-delimiter-face "# "
2:2 font-lock-comment-face "A golden fixture of shell: back up a directory, keeping a few copies.\n"
3:0 font-lock-builtin-face "set"
5:0 font-lock-builtin-face "readonly"
5:9 font-lock-variable-name-face "KEEP"
6:0 font-lock-variable-name-face "target"
6:7 font-lock-string-face "\"${1:-$HOME/notes}\""
8:0 font-lock-function-name-face "backup"
8:6 (rainbow-delimiters-depth-1-face) "("
8:7 (rainbow-delimiters-depth-1-face) ")"
8:9 (rainbow-delimiters-depth-1-face) "{"
9:2 font-lock-builtin-face "local"
9:8 font-lock-variable-name-face "source"
9:15 font-lock-string-face "\"$1\""
10:2 font-lock-variable-name-face "stamp"
10:9 (rainbow-delimiters-depth-2-face) "("
10:10 sh-quoted-exec "date +%Y%m%d"
10:22 (rainbow-delimiters-depth-2-face) ")"
11:11 font-lock-string-face "\"${source}-${stamp}.tar.gz\""
11:39 font-lock-string-face "\"$source\""
12:2 font-lock-builtin-face "echo"
12:7 font-lock-string-face "\"saved $source at $stamp\""
13:0 (rainbow-delimiters-depth-1-face) "}"
15:0 font-lock-keyword-face "if"
15:3 (rainbow-delimiters-depth-1-face) "["
15:4 (rainbow-delimiters-depth-2-face) "["
15:6 font-lock-negation-char-face "!"
15:11 font-lock-string-face "\"$target\""
15:21 (rainbow-delimiters-depth-2-face) "]"
15:22 (rainbow-delimiters-depth-1-face) "]"
15:25 font-lock-keyword-face "then"
16:2 font-lock-builtin-face "echo"
16:7 font-lock-string-face "\"no directory: $target\""
17:2 font-lock-keyword-face "exit"
18:0 font-lock-keyword-face "fi"
20:0 font-lock-variable-name-face "count"
21:0 font-lock-keyword-face "for"
21:11 font-lock-keyword-face " in"
21:15 font-lock-string-face "\"$target\""
21:35 font-lock-keyword-face "do"
22:2 font-lock-keyword-face "case"
22:7 font-lock-string-face "\"$archive\""
22:17 font-lock-keyword-face " in"
23:19 font-lock-string-face "\"$archive\""
24:7 font-lock-variable-name-face "count"
24:14 (rainbow-delimiters-depth-1-face) "("
24:15 (rainbow-delimiters-depth-2-face sh-quoted-exec) "("
24:16 sh-quoted-exec "count + 1"
24:25 (rainbow-delimiters-depth-2-face) ")"
24:26 (rainbow-delimiters-depth-1-face) ")"
25:2 font-lock-keyword-face "esac"
26:0 font-lock-keyword-face "done"
28:0 font-lock-keyword-face "while "
28:6 font-lock-builtin-face "read"
28:20 font-lock-keyword-face "do"
29:2 font-lock-builtin-face "printf"
29:9 font-lock-string-face "'%s\\n'"
29:16 font-lock-string-face "\"$line\""
30:0 font-lock-keyword-face "done"
30:10 sh-heredoc "\nkept $KEEP copies\nEOF\n"
34:7 font-lock-string-face "\"$target\""
